# .env example

# Default provider (mock, openai, anthropic, or any OpenAI-compatible)
PROVIDER=mock

# Default LLM model
LLM=gpt-4o

# API key for LLM provider
# Required for openai/anthropic/OpenAI-compatible
API_KEY=

# Custom endpoint (optional)
# If not set, uses default for provider
ENDPOINT=

# Default project path (optional)
PROJECT=

# Server port
PORT=8080